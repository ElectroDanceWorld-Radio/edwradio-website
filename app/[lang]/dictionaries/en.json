  "welcome": {
    "title": "Welcome!",
    "text1a": "Welcome to ElectroDanceWorld, your ultimate destination to immerse yourself in the exciting world of electronic music! Here at ElectroDanceWorld, we are committed to offering you a unique and thrilling audio experience that will keep you moving and in tune with the most vibrant rhythms.",
    "text1b": "Our music player at the bottom of the page lets you start enjoying electronic music immediately.",
    "text2a": "From pulsating Techno to energetic House and captivating Trance rhythms, our track selection is designed to satisfy the tastes of true electronic music fans and those who are not so much — listen to us and follow us on our social networks to stay up to date.",
    "text2b": "Explore our carefully designed sections so you can dive into the complete experience.",
    "imageAlt": "ElectroDanceWorld DJ live"
  },
