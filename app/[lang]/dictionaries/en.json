  "content": {
    "section1_title": "Collaborations",
    "section1_text": "We are proud to collaborate with DJs, promoters, and artists who share our passion for electronic music. From live broadcasts at the most exclusive events to themed mix collaborations, we are committed to taking the electronic music experience to new heights. Stay tuned for our exciting events and collaborations.",
    "collaborations": [
      {
        "title": "A summer story",
        "text": "We are proud to say that we have attended as press to the main electronic music festival in Madrid for several years, committed to showing in real time the exciting vibe of the festival, thus starting the summer.",
        "button": "Details"
      },
      {
        "title": "Club",
        "text": "We cover various events in clubs in the city and outside the city thanks to our team of correspondents that we have throughout Spain, USA, Mexico, among others.",
